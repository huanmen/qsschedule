<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glass_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="6dp">
    <FrameLayout android:id="@+id/widget_glass_header" android:layout_width="match_parent" android:layout_height="56dp">
        <ImageView android:id="@+id/widget_glass_header_background" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/widget_today_glass_header_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="3dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_glass_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"
                android:text="今日课表" android:textColor="#20344B" android:textSize="16sp" />
            <TextView android:id="@+id/widget_glass_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:maxLines="1" android:textColor="#2D7891" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_glass_date" android:layout_width="match_parent" android:layout_height="13dp"
            android:includeFontPadding="false" android:maxLines="1" android:textColor="#63798E" android:textSize="10sp" />
        <ImageView android:id="@+id/widget_glass_progress" android:layout_width="match_parent" android:layout_height="14dp"
            android:scaleType="fitXY" android:contentDescription="今日课程进度" />
    </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_glass_course_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent" android:divider="@android:color/transparent" android:dividerHeight="5dp"
            android:scrollbars="none" android:overScrollMode="never" android:listSelector="@android:color/transparent" />
        <LinearLayout android:id="@+id/widget_focus_preview" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone" />
        <LinearLayout android:id="@+id/widget_glass_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:id="@+id/widget_glass_empty_background_1" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_today_glass_course_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_glass_empty_message_1" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:padding="8dp" android:textColor="#63798E" android:textSize="15sp" />
            </FrameLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="5dp" android:importantForAccessibility="no" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:id="@+id/widget_glass_empty_background_2" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_today_glass_course_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_glass_empty_message_2" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:padding="8dp" android:textColor="#63798E" android:textSize="15sp" />
            </FrameLayout>
            <ImageView android:id="@+id/widget_glass_empty_gap_3" android:layout_width="match_parent" android:layout_height="5dp" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/widget_glass_empty_card_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:id="@+id/widget_glass_empty_background_3" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_today_glass_course_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
