[Unit]
Description=QSSchedule local plugin administration
After=network.target

[Service]
Type=simple
User=qsschedule
Group=qsschedule
WorkingDirectory=/opt/qsschedule
Environment=QSS_DATA=/var/lib/qsschedule
ExecStart=/usr/bin/python3 /opt/qsschedule/plugin_admin.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qsschedule

[Install]
WantedBy=multi-user.target
